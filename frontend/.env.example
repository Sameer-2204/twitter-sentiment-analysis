# ─────────────────────────────────────────────────────────────
#  Twitter Sentiment Analysis — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────
#
#  Copy this file to .env and update the values:
#    copy .env.example .env
#
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
#
# Local development (backend on your machine):
#   VITE_API_BASE=http://localhost:8000
#
# Cloudflare Tunnel (backend exposed via tunnel):
#   VITE_API_BASE=https://your-tunnel-id.trycloudflare.com
#
# NOTE: The tunnel URL changes every time you restart cloudflared.
#       Update this value and restart the frontend dev server.
#
VITE_API_BASE=http://localhost:8000
