# =============================================================================
# .dockerignore — Project root (build context for backend Docker image)
# =============================================================================

# ── Version control ──────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python artifacts ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/

# ── Environment files (secrets) ──────────────────────────────
.env
.env.*
!backend/.env.example

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/

# ── Frontend (not needed in backend image) ───────────────────
frontend/
next-app/

# ── Notebooks & scripts (not needed at runtime) ─────────────
notebooks/
scripts/
configs/
docs/
logs/
Microsoft/
twitter_analysis.egg-info/

# ── Embeddings (large, not needed at runtime) ────────────────
embeddings/
gloVE/

# ── Notebooks ────────────────────────────────────────────────
*.ipynb

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
.vercel/
