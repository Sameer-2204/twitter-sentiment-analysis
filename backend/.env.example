# ====================================================
# TWITTER SENTIMENT ANALYZER — Environment Variables
# ====================================================

# Debug mode (true for local, false for production)
DEBUG=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS — Allowed origins (comma-separated)
# Local development:
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ====================================================
# PATHS (auto-detected locally, set via Docker ENV in prod)
# ====================================================
# MODELS_DIR=../models
# DATA_DIR=../data
# REPORTS_DIR=../reports
