# ── App Settings ──────────────────────────────────────────────
DEBUG=False

# ── CORS (comma-separated allowed origins) ───────────────────
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# ── Deployment Mode ──────────────────────────────────────────
# LIGHTWEIGHT_MODE: Only loads Logistic Regression at startup (~15 MB)
# Set to false to load all 5 models eagerly (requires ~3-4 GB RAM)
LIGHTWEIGHT_MODE=true

# LAZY_LOADING: Load heavy models (LSTM, BiLSTM, CNN, DistilBERT)
# on first prediction request instead of at startup.
# Previous heavy model is unloaded to free RAM.
LAZY_LOADING=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Paths (override only if different from defaults) ─────────
# DATA_DIR=/path/to/data
# MODELS_DIR=/path/to/models
# REPORTS_DIR=/path/to/reports
