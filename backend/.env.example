# ====================================================
# TWITTER SENTIMENT ANALYZER - LOCAL DEVELOPMENT
# ====================================================

# Debug mode (keep true for local development)
DEBUG=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Allow all origins for local development
# When using Cloudflare Tunnel, requests come from tunnel domain
ALLOWED_ORIGINS=*

# ====================================================
# PATHS (usually auto-detected, override if needed)
# ====================================================
# MODELS_DIR=../models
# DATA_DIR=../data
# REPORTS_DIR=../reports
